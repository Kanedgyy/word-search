    "better-auth": "^1.6.10",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "next": "16.2.4",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "superjson": "^2.2.3",
